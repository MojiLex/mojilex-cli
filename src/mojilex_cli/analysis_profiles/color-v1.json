      "visible_area_bp": 7656,
      "dominant_colors": [
        {"hex": "#ff0000", "family": "red", "coverage_bp": 10000}
      ]
    },
    {
      "id": "transparent-red-dot-2x2",
      "rgba_hex": "ff0000ff112233001122330011223300",
      "width": 2,
      "height": 2,
      "alpha_mode": "binary",
      "visible_area_bp": 1914,
      "dominant_colors": [
        {"hex": "#ff0000", "family": "red", "coverage_bp": 10000}
      ]
    }
  ]
}
