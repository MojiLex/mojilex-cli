{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlx://schemas/distribution/v1/search-record.schema.json",
  "title": "MojiLex lexical search record v1",
  "type": "object",
  "required": [
    "record_schema_version",
    "entity_type",
    "emoji_id",
    "language",
    "canonical_locator",
    "canonical_record_sha256",
    "platform",
    "native_reference_count",
    "native_references",
    "native_references_truncated",
    "collection_count",
    "collection_ids",
    "collections_truncated",
    "description",
    "semantic",
    "facets",
    "literal_text",
    "availability",
    "review",
    "content",
    "rights",
    "duplicate_group_count",
    "duplicate_group_ids",
    "duplicate_groups_truncated",
    "platform_capability_refs"
  ],
  "properties": {
    "record_schema_version": {"const": "1.0.0"},
    "entity_type": {"const": "search_record"},
    "emoji_id": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/emojiId"},
    "language": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/languageTag"},
    "canonical_locator": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/canonicalLocator"},
    "canonical_record_sha256": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/sha256"},
    "platform": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/platform"},
    "native_reference_count": {"type": "integer", "minimum": 1},
    "native_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/nativeReference"}
    },
    "native_references_truncated": {"type": "boolean"},
    "collection_count": {"type": "integer", "minimum": 1},
    "collection_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/collectionId"}
    },
    "collections_truncated": {"type": "boolean"},
    "description": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/description"},
    "semantic": {
      "type": "object",
      "required": ["concept_ids", "semantic_tags"],
      "properties": {
        "concept_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/conceptId"}
        },
        "semantic_tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 48}
        }
      },
      "additionalProperties": false
    },
    "facets": {"$ref": "#/$defs/searchFacets"},
    "literal_text": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/literalText"}
    },
    "availability": {"$ref": "#/$defs/searchAvailability"},
    "review": {
      "type": "object",
      "required": [
        "status", "attested", "provenance_origin", "model_qualification_status",
        "model_qualification", "generation_attestation_status"
      ],
      "properties": {
        "status": {"enum": ["unreviewed", "approved", "changes_requested", "rejected"]},
        "attested": {"type": "boolean"},
        "review_attestation_id": {"type": "string", "pattern": "^mxa_[0-9a-f-]{36}$"},
        "provenance_origin": {"enum": ["ai", "human", "mixed"]},
        "model_qualification_status": {
          "enum": ["active", "expired-for-new-generation", "revoked", "missing", "mismatch", "invalid", "not-applicable"]
        },
        "model_qualification": {"$ref": "#/$defs/qualificationComponent"},
        "generation_attestation_status": {"enum": ["valid", "missing", "mismatch", "invalid", "revoked", "not-applicable"]},
        "generation_attestation_id": {"type": "string", "pattern": "^mxg_sha256_[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"attested": {"const": true}}, "required": ["attested"]},
          "then": {"required": ["review_attestation_id"]},
          "else": {"not": {"required": ["review_attestation_id"]}}
        },
        {
          "if": {"properties": {"generation_attestation_status": {"enum": ["valid", "mismatch", "invalid", "revoked"]}}, "required": ["generation_attestation_status"]},
          "then": {"required": ["generation_attestation_id"]},
          "else": {"not": {"required": ["generation_attestation_id"]}}
        }
      ],
      "additionalProperties": false
    },
    "content": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/content"},
    "rights": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/rightsSummary"},
    "duplicate_group_count": {"type": "integer", "minimum": 0},
    "duplicate_group_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/duplicateGroupId"}
    },
    "duplicate_groups_truncated": {"type": "boolean"},
    "platform_capability_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$", "maxLength": 128}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "searchFacets": {
      "type": "object",
      "required": [
        "animated", "media_kinds", "color_behaviors", "color_families", "contains_text",
        "content_types", "styles", "suggested_uses", "uncertainties"
      ],
      "properties": {
        "animated": {"type": "boolean"},
        "media_kinds": {"$ref": "#/$defs/kebabArray"},
        "color_behaviors": {"$ref": "#/$defs/kebabArray"},
        "color_families": {"$ref": "#/$defs/kebabArray"},
        "contains_text": {"type": "boolean"},
        "content_types": {"$ref": "#/$defs/kebabArray"},
        "styles": {"$ref": "#/$defs/kebabArray"},
        "suggested_uses": {"$ref": "#/$defs/kebabArray"},
        "uncertainties": {"$ref": "#/$defs/kebabArray"}
      },
      "additionalProperties": false
    },
    "searchAvailability": {
      "type": "object",
      "required": ["status", "freshness_status"],
      "properties": {
        "status": {"const": "active"},
        "freshness_status": {"enum": ["current", "stale", "unknown"]},
        "last_verified_at": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"freshness_status": {"enum": ["current", "stale"]}}, "required": ["freshness_status"]},
          "then": {"required": ["last_verified_at"]},
          "else": {"not": {"required": ["last_verified_at"]}}
        }
      ],
      "additionalProperties": false
    },
    "kebabArray": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64}
    },
    "qualificationComponent": {
      "oneOf": [
        {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/absentComponent"},
        {
          "type": "object",
          "required": ["present", "value"],
          "properties": {
            "present": {"const": true},
            "value": {
              "type": "object",
              "required": ["qualification_id", "qualification_core_sha256", "qualification_attestation_id"],
              "properties": {
                "qualification_id": {"type": "string", "pattern": "^mq_[a-z0-9]+(?:[-_.][a-z0-9]+)*$"},
                "qualification_core_sha256": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/sha256"},
                "qualification_attestation_id": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/stringOptionalComponent"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
