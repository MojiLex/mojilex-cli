{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlx://schemas/distribution/v1/rights-profiles-registry.schema.json",
  "title": "MojiLex rights profiles registry v1",
  "type": "object",
  "required": [
    "registry_schema_version",
    "registry_type",
    "registry_id",
    "project_default_profile_id",
    "profiles"
  ],
  "properties": {
    "registry_schema_version": {"const": "1.0.0"},
    "registry_type": {"const": "rights-profiles"},
    "registry_id": {
      "$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/identifier"
    },
    "project_default_profile_id": {
      "$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/identifier"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "mlx://schemas/distribution/v1/rights-profile.schema.json"}
    }
  },
  "additionalProperties": false
}
