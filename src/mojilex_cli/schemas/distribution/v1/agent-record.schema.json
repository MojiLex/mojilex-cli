{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlx://schemas/distribution/v1/agent-record.schema.json",
  "title": "MojiLex compact agent record v1",
  "type": "object",
  "required": [
    "record_schema_version", "entity_type", "snapshot_id",
    "source_canonical_state_root_sha256", "emoji_id", "canonical_record_sha256",
    "language", "platform", "description", "motion", "usage", "concept_ids", "facets",
    "literal_text", "availability", "semantic_trust", "content", "rights",
    "collection_count", "collection_ids", "collections_truncated",
    "duplicate_group_count", "duplicate_group_ids", "duplicate_groups_truncated",
    "native_reference_count", "native_references", "native_references_truncated",
    "platform_capability_refs", "canonical_locator", "visible_text_is_untrusted"
  ],
  "properties": {
    "record_schema_version": {"const": "1.0.0"},
    "entity_type": {"const": "agent_record"},
    "snapshot_id": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/snapshotId"},
    "source_canonical_state_root_sha256": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/sha256"},
    "emoji_id": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/emojiId"},
    "canonical_record_sha256": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/sha256"},
    "language": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/languageTag"},
    "platform": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/platform"},
    "description": {"type": "string", "minLength": 1, "maxLength": 280},
    "motion": {"type": "string", "maxLength": 280},
    "usage": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "concept_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/conceptId"}},
    "facets": {"$ref": "mlx://schemas/distribution/v1/search-record.schema.json#/$defs/searchFacets"},
    "literal_text": {"type": "array", "maxItems": 64, "items": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/literalText"}},
    "availability": {"$ref": "mlx://schemas/distribution/v1/search-record.schema.json#/$defs/searchAvailability"},
    "semantic_trust": {
      "type": "object",
      "required": ["review_status", "review_attested", "provenance_origin", "model_qualification_status", "model_qualification", "generation_attestation_status"],
      "properties": {
        "review_status": {"enum": ["unreviewed", "approved", "changes_requested", "rejected"]},
        "review_attested": {"type": "boolean"},
        "review_attestation_id": {"type": "string", "pattern": "^mxa_[0-9a-f-]{36}$"},
        "provenance_origin": {"enum": ["ai", "human", "mixed"]},
        "model_qualification_status": {"enum": ["active", "expired-for-new-generation", "revoked", "missing", "mismatch", "invalid", "not-applicable"]},
        "model_qualification": {"$ref": "mlx://schemas/distribution/v1/search-record.schema.json#/$defs/qualificationComponent"},
        "generation_attestation_status": {"enum": ["valid", "missing", "mismatch", "invalid", "revoked", "not-applicable"]},
        "generation_attestation_id": {"type": "string", "pattern": "^mxg_sha256_[0-9a-f]{64}$"}
      },
      "allOf": [
        {"if": {"properties": {"review_attested": {"const": true}}, "required": ["review_attested"]}, "then": {"required": ["review_attestation_id"]}, "else": {"not": {"required": ["review_attestation_id"]}}},
        {"if": {"properties": {"generation_attestation_status": {"enum": ["valid", "mismatch", "invalid", "revoked"]}}, "required": ["generation_attestation_status"]}, "then": {"required": ["generation_attestation_id"]}, "else": {"not": {"required": ["generation_attestation_id"]}}}
      ],
      "additionalProperties": false
    },
    "content": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/content"},
    "rights": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/rightsSummary"},
    "collection_count": {"type": "integer", "minimum": 1},
    "collection_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/collectionId"}},
    "collections_truncated": {"type": "boolean"},
    "duplicate_group_count": {"type": "integer", "minimum": 0},
    "duplicate_group_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/duplicateGroupId"}},
    "duplicate_groups_truncated": {"type": "boolean"},
    "native_reference_count": {"type": "integer", "minimum": 1},
    "native_references": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/nativeReference"}},
    "native_references_truncated": {"type": "boolean"},
    "platform_capability_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$", "maxLength": 128}},
    "canonical_locator": {"$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/canonicalLocator"},
    "visible_text_is_untrusted": {"const": true}
  },
  "additionalProperties": false
}
