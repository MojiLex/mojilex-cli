{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlx://schemas/distribution/v1/concepts-registry.schema.json",
  "title": "MojiLex concepts registry v1",
  "type": "object",
  "required": ["registry_schema_version", "registry_type", "registry_id", "concepts"],
  "properties": {
    "registry_schema_version": {"const": "1.0.0"},
    "registry_type": {"const": "concepts"},
    "registry_id": {
      "$ref": "mlx://schemas/distribution/v1/distribution-common.schema.json#/$defs/identifier"
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "mlx://schemas/distribution/v1/concept.schema.json"}
    }
  },
  "additionalProperties": false
}
