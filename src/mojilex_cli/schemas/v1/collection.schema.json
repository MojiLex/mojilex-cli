{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mojilex.org/v1/collection.schema.json",
  "title": "MojiLex collection v1",
  "type": "object",
  "required": [
    "schema_version",
    "entity_type",
    "id",
    "platform",
    "kind",
    "native_namespace",
    "scope_id",
    "native_id",
    "identity_epoch",
    "title",
    "availability",
    "item_count",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://schemas.mojilex.org/v1/common.schema.json#/$defs/schemaVersion"
    },
    "entity_type": {
      "const": "collection"
    },
    "id": {
      "$ref": "https://schemas.mojilex.org/v1/common.schema.json#/$defs/collectionId"
    },
    "platform": {
      "$ref": "https://schemas.mojilex.org/v1/common.schema.json#/$defs/platform"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "native_namespace": {
      "$ref": "https://schemas.mojilex.org/v1/common.schema.json#/$defs/identityComponent"
    },
    "scope_id": {
      "$ref": "https://schemas.mojilex.org/v1/common.schema.json#/$defs/identityComponent"
    },
    "native_id": {
      "$ref": "https://schemas.mojilex.org/v1/common.schema.json#/$defs/identityComponent"
    },
    "identity_epoch": {
      "$ref": "https://schemas.mojilex.org/v1/common.schema.json#/$defs/identityEpoch"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#]+/[^?#]+$",
      "maxLength": 2048
    },
    "availability": {
      "$ref": "https://schemas.mojilex.org/v1/common.schema.json#/$defs/availability"
    },
    "item_count": {
      "type": "integer",
      "minimum": 0
    },
    "extensions": {
      "type": "object",
      "properties": {
        "telegram": {
          "$ref": "https://schemas.mojilex.org/v1/extensions/telegram.schema.json#/$defs/collection"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "platform": {
            "const": "telegram"
          }
        },
        "required": [
          "platform"
        ]
      },
      "then": {
        "required": [
          "canonical_url"
        ],
        "properties": {
          "kind": {
            "const": "custom_emoji_set"
          },
          "native_namespace": {
            "const": "sticker_set.name"
          },
          "scope_id": {
            "const": "global"
          },
          "canonical_url": {
            "type": "string",
            "pattern": "^https://t\\.me/addemoji/[A-Za-z0-9_]+$"
          },
          "extensions": {
            "required": [
              "telegram"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
